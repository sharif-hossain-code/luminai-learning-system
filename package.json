{
  "name": "luminai-learning-system",
  "private": true,
  "description": "AI-powered learning platform for language, communication and leadership skills",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @luminai/database db:generate",
    "db:migrate": "pnpm --filter @luminai/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @luminai/database db:migrate:deploy",
    "db:seed": "pnpm --filter @luminai/database db:seed",
    "db:reset": "pnpm --filter @luminai/database db:reset"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
