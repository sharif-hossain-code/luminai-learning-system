# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# The API validates its variables at startup and refuses to start if any are missing or invalid.

NODE_ENV=development

# --- Local Docker services (docker-compose.yml) ---
POSTGRES_USER=luminai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=luminai
POSTGRES_PORT=5432
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# --- Application URLs ---
# Exact origin of the web app; the API's CORS allowlist.
WEB_URL=http://localhost:3000
# Base URL the web app uses to call the API from the server.
API_URL=http://localhost:4000
API_PORT=4000

# --- Data stores ---
# Use the same credentials as above. URL-encode special characters in passwords.
DATABASE_URL=postgresql://luminai:CHANGE_ME@localhost:5432/luminai
# Separate database for integration tests (created by infra/docker/postgres/init on first start).
TEST_DATABASE_URL=postgresql://luminai:CHANGE_ME@localhost:5432/luminai_test
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# --- Security ---
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME

# --- Logging: fatal | error | warn | info | debug ---
LOG_LEVEL=info

# --- AI (not used until the AI mentor phase) ---
AI_PROVIDER=mock
AI_API_KEY=

# --- Object storage (not used until the content phase) ---
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
