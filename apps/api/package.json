{
  "name": "@luminai/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API (modular monolith)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@luminai/contracts": "workspace:*",
    "@luminai/database": "workspace:*",
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-fastify": "12.6.3",
    "fastify": "5.12.8",
    "ioredis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.17",
    "@nestjs/testing": "12.6.3",
    "@types/node": "24.19.4",
    "eslint": "10.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
